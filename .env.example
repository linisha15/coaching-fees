DATABASE_URL="file:./dev.db"
# Demo clock (IST date). Brief sample data is anchored to this day.
DEMO_TODAY="2026-11-02"
# Optional. Without it, counsellor explanations fall back to a template.
ANTHROPIC_API_KEY=""
# Mocked SMS OTP: fixed code for demos. Remove in a real deployment.
MOCK_OTP_CODE="123456"
# Bearer secret for the daily POST /api/reminders/tick cron.
CRON_SECRET="change-me"
# Base URL used in reminder pay links.
APP_URL="http://localhost:3000"
# Shows a "Reset demo data" button for accounts users. Demo deployments only.
ALLOW_DEMO_RESET="true"
